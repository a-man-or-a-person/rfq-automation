# Advanced adapters only. The offline demo requires no .env file.
LIVE_INTEGRATIONS_ENABLED=false
MAILBOX_NAME=demo@example.com
MAILBOX_APP_PASSWORD=replace-locally
IMAP_SERVER=imap.example.com
SMTP_SERVER=smtp.example.com
SEVEN_RIGHTS_API_BASE_URL=https://example.com/
SEVEN_RIGHTS_API_VERSION=api/v1/
SEVEN_RIGHTS_API_KEY=replace-locally
SEVEN_RIGHTS_API_AWAIT_TIMEOUT=30
APP_ENV=dev
MAIL_SERVER=INTERNET
EXCHANGE_USERNAME=DEMO\demo
EXCHANGE_PASSWORD=replace-locally
EXCHANGE_SERVER=mail.example.com
PRIMARY_SMTP_ADDRESS=demo@example.com
